{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/zalgo",
      "destination": "/api/zalgo"
    },
    {
      "source": "/clean",
      "destination": "/api/clean"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 15
    }
  }
}
