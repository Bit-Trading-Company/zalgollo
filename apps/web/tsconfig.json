{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client"],
    "paths": { "@zalgollo/core": ["../../packages/core/src/index.ts"] }
  },
  "include": ["src", "vite.config.ts"]
}
